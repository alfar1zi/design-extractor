{
  "name": "design-extractor",
  "version": "0.2.0",
  "description": "Reverse-engineer a website's design system into an offline-reproducible reference: tokens, motion, states, components.",
  "type": "module",
  "bin": {
    "design-extractor": "./scripts/cli.mjs",
    "design-extractor-save": "./scripts/saveweb2zip.mjs",
    "design-extractor-inspect": "./scripts/inspect.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install:browsers": "playwright install chromium",
    "test": "node scripts/run-tests.mjs",
    "lint": "node scripts/lint.mjs",
    "validate": "node scripts/validate-plugin.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "looks-same": "^10.0.1",
    "playwright": "^1.48.0",
    "source-map": "^0.8.0",
    "yauzl": "^3.2.0"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "ai-agents",
    "playwright",
    "design-system",
    "design-tokens",
    "reverse-engineering",
    "website-clone",
    "motion",
    "css",
    "accessibility",
    "cli",
    "scraper",
    "opencode",
    "codex"
  ],
  "files": [
    ".claude-plugin",
    "commands",
    "scripts",
    "!scripts/__tests__",
    "skills",
    "assets",
    "examples",
    "install.sh",
    "install.ps1",
    "skill.json",
    "skills.sh.json",
    "SECURITY.md",
    "CITATION.cff",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "alfar1zi",
  "repository": {
    "type": "git",
    "url": "https://github.com/alfar1zi/design-extractor.git"
  }
}
