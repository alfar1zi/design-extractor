{
  "name": "design-extractor",
  "version": "0.1.0",
  "description": "Skill + CLI for deep, faithful reference capture of any website: download real source, watch it move in a browser, document tokens/components/motion. Stops being a screenshot trap.",
  "type": "module",
  "bin": {
    "design-extractor": "./scripts/cli.mjs",
    "design-extractor-save": "./scripts/saveweb2zip.mjs",
    "design-extractor-inspect": "./scripts/inspect.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install:browsers": "playwright install chromium",
    "test": "node scripts/run-tests.mjs",
    "validate": "node scripts/validate-plugin.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "looks-same": "^10.0.1",
    "playwright": "^1.48.0",
    "source-map": "^0.8.0",
    "undici": "^6.0.0",
    "yauzl": "^3.2.0"
  },
  "optionalDependencies": {
    "@mozilla/readability": "^0.5.0",
    "jsdom": "^25.0.0"
  },
  "keywords": [
    "skill",
    "agent",
    "design",
    "reference",
    "claude-code",
    "opencode",
    "playwright",
    "scrape",
    "audit",
    "motion"
  ],
  "files": [
    "commands",
    "scripts",
    "!scripts/__tests__",
    "skills",
    "assets",
    "examples",
    "install.sh",
    "install.ps1",
    "skill.json",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "alfar1zi",
  "repository": {
    "type": "git",
    "url": "https://github.com/alfar1zi/design-extractor.git"
  }
}
